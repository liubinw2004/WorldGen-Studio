# Normalise line endings so the repo behaves the same on every checkout.
# Batch files MUST be CRLF: cmd.exe mis-parses labels in LF-only .bat files.
* text=auto eol=lf

*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.sh  text eol=lf
*.py  text eol=lf
*.md  text eol=lf

*.png binary
*.jpg binary
*.pth binary
*.ply binary
